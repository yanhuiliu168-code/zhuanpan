/* pages/edit/edit.wxss */
.container {
  padding: 30rpx;
  background-color: #f7f8fa;
}

.form-group {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.label {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.input {
  font-size: 28rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.items-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.item-row:last-child {
  border-bottom: none;
}

.color-picker {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #ddd;
}

.item-input {
  flex: 1;
  font-size: 28rpx;
  padding: 10rpx;
}

.btn-del-item {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFE4E1;
  color: #FF4500;
  font-size: 40rpx;
  margin-left: 20rpx;
}

.btn-add-item {
  margin-top: 30rpx;
  background: #fff;
  color: #FF8C00;
  border: 2rpx dashed #FF8C00;
  border-radius: 20rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.footer {
  margin-top: 60rpx;
  padding-bottom: 60rpx;
}

.btn-save {
  background: #FF8C00;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 90% !important;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.3);
}
