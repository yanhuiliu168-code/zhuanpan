<!--pages/edit/edit.wxml-->
<view class="container">
  <view class="form-group">
    <view class="label">转盘名称</view>
    <input class="input-name" value="{{roulette.name}}" bindinput="onNameInput" placeholder="请输入转盘名称（如：周末去哪儿）" disabled="{{roulette.isDefault}}" />
  </view>

  <view class="label" style="padding: 0 30rpx;">转盘选项 ({{roulette.items.length}}/12)</view>
  <view class="items-container">
    <view class="item-row" wx:for="{{roulette.items}}" wx:key="index">
      <view class="color-picker" style="background-color: {{item.color}};" bindtap="changeColor" data-index="{{index}}"></view>
      <input class="input-item" value="{{item.text}}" bindinput="onItemInput" data-index="{{index}}" placeholder="请输入选项内容" />
      <view class="btn-del" bindtap="deleteItem" data-index="{{index}}">×</view>
    </view>
  </view>

  <button class="btn-add" bindtap="addItem">+ 添加选项</button>
  <button class="btn-save" bindtap="save">保存</button>
</view>
