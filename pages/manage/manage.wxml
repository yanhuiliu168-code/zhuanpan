<!--pages/manage/manage.wxml-->
<view class="container">
  <view class="header">
    <text class="title">{{currentType === 'reward' ? '奖励转盘' : '惩罚转盘'}}</text>
  </view>

  <scroll-view scroll-y class="list-container">
    <view class="list-item {{item.id === currentId ? 'active' : ''}}" wx:for="{{roulettes}}" wx:key="id" bindtap="selectRoulette" data-id="{{item.id}}">
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-tag" wx:if="{{item.isDefault}}">默认</text>
      </view>
      <view class="item-actions">
        <button class="btn-edit" catchtap="editRoulette" data-id="{{item.id}}">编辑</button>
        <button class="btn-delete" wx:if="{{!item.isDefault}}" catchtap="deleteRoulette" data-id="{{item.id}}">删除</button>
      </view>
      <view class="selected-icon" wx:if="{{item.id === currentId}}">✓</view>
    </view>
  </scroll-view>

  <view class="footer">
    <button class="btn-add" bindtap="addRoulette">+ 新增{{currentType === 'reward' ? '奖励' : '惩罚'}}转盘</button>
  </view>
</view>