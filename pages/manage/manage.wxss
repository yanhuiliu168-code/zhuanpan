/* pages/manage/manage.wxss */
.container {
  padding: 30rpx;
  background-color: #f7f8fa;
}

.header {
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.list-container {
  flex: 1;
  width: 100%;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  border: 2rpx solid transparent;
}

.list-item.active {
  border-color: #FF8C00;
  background: #FFF9E6;
}

.item-info {
  display: flex;
  align-items: center;
}

.item-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.item-tag {
  font-size: 20rpx;
  background: #eee;
  color: #999;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 20rpx;
}

.item-actions {
  display: flex;
  gap: 20rpx;
  margin-right: 40rpx;
}

.btn-edit, .btn-delete {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  margin: 0;
  line-height: 1.5;
  border-radius: 30rpx;
}

.btn-edit {
  background: #f0f0f0;
  color: #333;
}

.btn-delete {
  background: #FFE4E1;
  color: #FF4500;
}

.selected-icon {
  position: absolute;
  right: 30rpx;
  color: #FF8C00;
  font-size: 40rpx;
  font-weight: bold;
}

.footer {
  width: 100%;
  padding: 40rpx 0;
}

.btn-add {
  background: #FF8C00;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 90% !important;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.3);
}
