/* pages/play/play.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f7f8fa;
  padding: 30rpx;
  box-sizing: border-box;
}

.roulette-container {
  margin-top: 100rpx;
  position: relative;
  width: 600rpx;
  height: 600rpx;
}

.roulette-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
  border: 10rpx solid #fff;
  box-sizing: border-box;
}

.roulette-wheel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
}

.wheel-line {
  position: absolute;
  top: 0;
  left: 50%;
  width: 4rpx;
  height: 50%;
  background-color: #fff;
  transform-origin: 50% 100%;
  margin-left: -2rpx;
  z-index: 2;
}

.wheel-text-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
}

.wheel-text {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: 50% 50%;
}

.text-content {
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  width: 140rpx;
  line-height: 1.4;
  word-break: break-all;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.5), 0 2rpx 4rpx rgba(0,0,0,0.3);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.roulette-pointer {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -100%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 60rpx solid #FF4500;
  z-index: 10;
  margin-top: -30rpx;
}

.roulette-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 120rpx;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
  z-index: 11;
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4500;
}

/* 弹窗样式 */
.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-dialog {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.result-content {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
}

.btn-close {
  background: #FF8C00;
  color: #fff;
  border-radius: 40rpx;
  width: 80%;
  font-size: 32rpx;
}

/* 控制面板 */
.control-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-panel {
  width: 80%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.panel-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.panel-mode {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  justify-content: center;
}

.mode-group {
  display: flex;
}

.mode-group label {
  margin-left: 20rpx;
}

.panel-queue {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding: 10rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  max-height: 120rpx;
  overflow-y: auto;
}

.queue-item {
  color: #FF4500;
  font-weight: bold;
}

.panel-list {
  max-height: 400rpx;
}

.panel-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1px solid #eee;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
}

.add-tip {
  font-size: 22rpx;
  color: #999;
}

.item-weight {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.weight-input {
  width: 60rpx;
  border: 1px solid #ccc;
  border-radius: 6rpx;
  text-align: center;
  margin-left: 10rpx;
}

.panel-actions {
  display: flex;
  margin-top: 30rpx;
  justify-content: space-between;
}

.panel-actions button {
  width: 30%;
  font-size: 28rpx;
  padding: 0;
}

.btn-clear { background: #FFE4E1; color: #FF4500; }
.btn-cancel { background: #eee; color: #333; }
.btn-confirm { background: #FF4500; color: #fff; }
