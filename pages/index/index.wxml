<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <text class="title">我的转盘</text>
    <text class="subtitle">选择一个转盘开始，或创建专属转盘</text>
  </view>

  <scroll-view scroll-y class="list-container">
    <view class="list-item" wx:for="{{roulettes}}" wx:key="id" bindtap="goToPlay" data-id="{{item.id}}">
      <view class="item-content">
        <view class="item-name">{{item.name}}</view>
        <view class="item-desc">包含 {{item.items.length}} 个选项</view>
      </view>
      <view class="item-actions">
        <view class="action-btn edit-btn" catchtap="goToEdit" data-id="{{item.id}}">编辑</view>
        <view class="action-btn delete-btn" wx:if="{{!item.isDefault}}" catchtap="deleteRoulette" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-area">
    <button class="btn-create" bindtap="createRoulette">
      <text class="plus-icon">+</text> 创建新转盘
    </button>
  </view>
</view>
